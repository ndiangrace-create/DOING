+function matches(row,key,value){
+  if(['select','order','limit','offset'].includes(key))return true;
+  if(key==='or')return value.slice(1,-1).split(',').some(clause=>{
+    const dot=clause.indexOf('.');return matches(row,clause.slice(0,dot),clause.slice(dot+1));
+  });
+  if(value.startsWith('eq.'))return String(row[key])===value.slice(3);
+  if(value.startsWith('neq.'))return String(row[key])!==value.slice(4);
+  if(value.startsWith('ilike.'))return String(row[key]||'').toLowerCase()===value.slice(6).toLowerCase();
+  if(value==='is.null')return row[key]==null;
+  if(value.startsWith('in.('))return value.slice(4,-1).split(',').includes(String(row[key]));
+  if(value.startsWith('not.in.('))return !value.slice(8,-1).split(',').includes(String(row[key]));
+  unexpectedFilters.push(`${key}=${value}`);throw Error(`Unhandled fixture filter ${key}=${value}`);
+}
+function rows(table, query='') {
+  if (table===failedTable) throw Error('simulated database failure');
+  const params = new URLSearchParams(query);
+  return (tables[table]||[]).filter(row => [...params].every(([key,value])=>matches(row,key,value)));
+}
+const db = {
+  get: async (table, query) => structuredClone(rows(table, query)),
+  insert: async (table, data) => { if(failInsert===table){failInsert='';throw Error('simulated insert failure');} writes.push({table, data}); (tables[table]??=[]).push(structuredClone(data)); return data; },
+  update: async (table, query, data) => { const targets=rows(table,query); writes.push({table,query,data}); targets.forEach(row=>Object.assign(row,structuredClone(data))); return true; },
+  delete: async (table,query) => { const selected=rows(table,query);tables[table]=(tables[table]||[]).filter(row=>!selected.includes(row));return true; },
+  upsert: async (table,data,keys='id')=>{const match=(tables[table]||[]).find(row=>keys.split(',').every(key=>row[key]===data[key]));if(match){Object.assign(match,structuredClone(data));return data;}return db.insert(table,data);},
+  rpc:async(name,p)=>{
+    if(!['claim_session_slot','release_session_slot'].includes(name))throw Error('Unsupported fixture RPC '+name);
+    const session=rows('sessions',`tenant_id=eq.${p.p_tenant_id}&id=eq.${p.p_session_id}`)[0];
+    assert.ok(session);const qty=Number(p.p_stall_count);
+    if(name==='claim_session_slot'&&session.limit_count>0&&Number(session.current_count||0)+qty>session.limit_count)return {ok:false,error:'名額不足'};
+    session.current_count=Math.max(0,Number(session.current_count||0)+(name==='claim_session_slot'?qty:-qty));return {ok:true};
+  }
+};
+const context = vm.createContext({
+  URL, URLSearchParams, Request, Response, Headers, TextEncoder, TextDecoder,
+  crypto:webcrypto, btoa, atob, console, setTimeout, clearTimeout, __db:db,
+  fetch:async()=>{throw Error('Unexpected external network request');}
+});
