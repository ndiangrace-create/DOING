+import { chromium } from 'playwright';
+import assert from 'node:assert/strict';
+import fs from 'node:fs';
+
+const BASE=process.env.E2E_BASE||'http://127.0.0.1:4173';
+const API='https://tobeloved-api.ndiangrace.workers.dev';
+const session={id:'S-ALPHA',eventId:'E-ALPHA',name:'市集與活動測試場次',status:'報名中',dates:[{date:'2030-10-10',label:'10/10',start:'10:00',end:'18:00'}],fee:300,deposit:0,limit:10,modules:{registration:true,review:true,payment:true,checkin:true,agreement:false},equip:{},addons:[],customFields:[]};
+const b64=value=>Buffer.from(JSON.stringify(value)).toString('base64url');
+const adminToken=`${b64({alg:'none'})}.${b64({tenant_id:'alpha',email:'owner@example.test',normalized_role:'organizer_owner',expires_at:Date.now()+60000})}.fixture`;
+const browser=await chromium.launch({headless:true});
+let checks=0;
+fs.mkdirSync('test-results/market-release',{recursive:true});
+async function prepare(viewport,{token='',profileMode='ok',delayProfile=0}={}){
+  const page=await browser.newPage({viewport});
+  page.setDefaultTimeout(8000);
+  const calls=[],errors=[],state={profileMode,delayProfile,paymentProfiles:[{id:'P-ALPHA',name:'原收款設定',isDefault:true,isEnabled:true,mode:'organizer_self',allowedMethods:{bank:true,linepay:true,card:false},bankAccount:{},linepay:{displayName:'既有 LINE Pay',url:'https://pay.example.test/fixture'}}]};
+  page.on('pageerror',e=>errors.push(e.message));
+  await page.addInitScript(token=>{
+    if(token)localStorage.setItem('doing_member_token',token);
+    sessionStorage.setItem('doing_market_page','consignment');
+  },token);
+  await page.route('**/*',async route=>{
+    const req=route.request(),u=new URL(req.url());
+    if(u.origin===new URL(BASE).origin)return route.continue();
+    if(u.origin!==API)return route.fulfill({status:200,body:'',contentType:'application/javascript'});
+    if(u.pathname.includes('/auth/line/start')){
+      calls.push({action:'oauth',returnUrl:u.searchParams.get('return_url')});
+      return route.fulfill({status:200,contentType:'text/html',body:'<p>Isolated OAuth handoff</p>'});
+    }
+    const body=req.method()==='POST'?req.postDataJSON():{};
+    const action=body.action||u.searchParams.get('action');
+    calls.push({action,tenant:body.tenant||u.searchParams.get('tenant'),body});
+    let data={success:true},status=200;
+    if(action==='getPlatformMemberProfile'){
+      if(state.delayProfile)await new Promise(resolve=>setTimeout(resolve,state.delayProfile));
+      if(state.profileMode==='expired'){status=401;data={error:'會員登入已失效'};}
+      else if(state.profileMode==='offline'){status=503;data={error:'連線失敗'};}
+      else data={profile:{id:'MEM-1',name:'測試會員',email:'member@example.test',phone:'0912345678',brand:'測試品牌'},brands:[],workspaces:[]};
+    }else if(action==='publicDiscovery')data={items:[{...session,tenantId:'alpha',sessionId:session.id,sessionName:session.name}]};
+    else if(action==='frontBootstrap')data={tenant:{id:'alpha',name:'主辦 Alpha',moduleFlags:{registration:true,consignment:false},i18n:{enabled:false}},events:[{id:'E-ALPHA',title:'活動主題'}],sessions:[session],announcements:[],operationUnits:[]};
+    else if(action==='getSession')data=session;
+    else if(action==='getMyRegsGlobal'||action==='getMyRegs')data=[{id:'REG-1',sessionId:session.id,sessionName:session.name,reviewStatus:'已錄取',paymentStatus:'未繳費',total:300,due:300,selectedDates:['2030-10-10'],brand:'測試品牌'}];
+    else if(action==='getSessionsAdmin'||action==='getAdminSessionsDashboard')data=[session];
+    else if(action==='getSiteConfig')data={brandName:'主辦 Alpha',logoUrl:'/doing-logo.png'};
+    else if(action==='getTenantModuleProfile')data={approvedFlags:{registration:true,consignment:false},useType:'market'};
+    else if(action==='adminMe')data={tenant:{name:'主辦 Alpha'}};
+    else if(action==='getPaymentProfiles')data=state.paymentProfiles;
+    else if(action==='getPaymentSettings')data={};
+    else if(action==='savePaymentProfile'){
+      state.paymentProfiles=[{...body,bankAccount:{bankName:body.bankName,branchName:body.bankBranch,accountName:body.accountName,accountNumber:body.bankAccount},linepay:{displayName:body.linepayDisplayName,url:body.linepayUrl},card:{displayName:body.cardDisplayName,url:body.cardUrl}}];data={success:true,id:body.id};
+    }
+    else if(['getBundlesPublic','getTodos','getMembers','getEventsAdmin','getMyNotifications','getMyCustomerWallets'].includes(action))data=[];
+    else if(action==='getMyRewards')data={balance:0,rows:[]};
+    return route.fulfill({status,contentType:'application/json',body:JSON.stringify(data)});
+  });
+  return {page,calls,errors,state};
+}
+async function clean(page,errors){assert.deepEqual(errors,[]);assert.equal(await page.evaluate(()=>innerWidth),page.viewportSize().width);assert.equal(await page.evaluate(()=>document.documentElement.scrollWidth<=innerWidth+1),true);await page.close();}
+try{
+  for(const viewport of [{width:1440,height:1000},{width:390,height:844}]){
+    // Global discovery -> selected tenant -> OAuth -> the same existing wizard.
+    {
+      const {page,calls,errors}=await prepare(viewport);
+      await page.goto(BASE+'/market/public/');
+      await page.locator('[data-global-register="S-ALPHA"]').click();
+      await page.waitForURL(url=>url.origin===API);
+      const returned=new URL(calls.find(x=>x.action==='oauth').returnUrl);
+      assert.equal(returned.origin,new URL(BASE).origin);
+      assert.equal(returned.searchParams.get('tenant'),'alpha');
+      assert.equal(returned.searchParams.get('session'),session.id);
+      assert.equal(returned.searchParams.get('market_autoreg'),'1');
+      returned.searchParams.set('member_token','fixture-member-token');
+      await page.goto(returned.toString());
+      await page.locator('#sessionModal.show').waitFor();
+      assert.equal(await page.locator('#regEmail').inputValue(),'member@example.test');
+      assert.equal(new URL(page.url()).searchParams.has('member_token'),false);
+      assert.equal(new URL(page.url()).searchParams.has('market_autoreg'),false);
+      assert.ok(calls.filter(x=>x.action==='getSession').every(x=>x.tenant==='alpha'));
+      await page.screenshot({path:`test-results/market-release/registration-${viewport.width}.png`});
+      await clean(page,errors); checks++;
+    }
+    // Invalid remembered token preserves the selected session during re-authentication.
+    {
+      const {page,calls,errors}=await prepare(viewport,{token:'expired-fixture',profileMode:'expired'});
+      await page.goto(BASE+'/market/public/?tenant=alpha');
+      await page.waitForFunction(()=>typeof openRegistration==='function');
+      await page.evaluate(()=>openRegistration('S-ALPHA'));
+      await page.waitForURL(url=>url.origin===API);
+      const returned=new URL(calls.find(x=>x.action==='oauth').returnUrl);
+      assert.equal(returned.searchParams.get('session'),session.id);assert.equal(returned.searchParams.get('tenant'),'alpha');
+      await clean(page,errors);checks++;
+    }
+    // Connection failure must not sign the user out or start another LINE verification.
+    {
+      const {page,calls,errors,state}=await prepare(viewport,{token:'valid-fixture',profileMode:'offline'});
+      await page.goto(BASE+'/market/public/?tenant=alpha');
+      await page.waitForFunction(()=>typeof openRegistration==='function'&&state.tenant==='alpha');
+      await page.evaluate(()=>openRegistration('S-ALPHA'));
+      assert.equal(calls.some(x=>x.action==='oauth'),false);
+      assert.equal(await page.evaluate(()=>localStorage.getItem('doing_member_token')),'valid-fixture');
+      state.profileMode='ok';
+      await page.evaluate(()=>openRegistration('S-ALPHA'));
+      await page.locator('#sessionModal.show').waitFor();
+      await clean(page,errors);checks++;
+    }
+    // A slow profile loads records on the first request, even on global discovery.
+    {
