diff --git a/scripts/audit-deployment-provenance.mjs b/scripts/audit-deployment-provenance.mjs
new file mode 100644
index 0000000..e5ab12a
--- /dev/null
+++ b/scripts/audit-deployment-provenance.mjs
@@ -0,0 +1,40 @@
+// Read-only provenance check. No deployment, secret values, DNS changes, or data writes.
+import fs from 'node:fs';
+const account=process.env.CLOUDFLARE_ACCOUNT_ID;
+const token=process.env.CLOUDFLARE_API_TOKEN;
+const result={checkedAt:new Date().toISOString(),mode:'read-only',productionWrites:0};
+const out='test-results/deployment-provenance.json';
+fs.mkdirSync('test-results',{recursive:true});
+if(!account||!token){
+  result.status='blocked_missing_credentials';
+}else{
+  const base=`https://api.cloudflare.com/client/v4/accounts/${encodeURIComponent(account)}`;
+  async function get(path){
+    const response=await fetch(base+path,{headers:{Authorization:`Bearer ${token}`},signal:AbortSignal.timeout(20000)});
+    if(!response.ok)return {status:'unavailable',httpStatus:response.status};
+    const data=await response.json();return data.success?{status:'available',data:data.result}:{status:'unavailable',httpStatus:response.status};
+  }
+  try{
+    const [pages,settings,deployments]=await Promise.all([
+      get('/pages/projects/doing-2'),get('/workers/scripts/tobeloved-api/settings'),get('/workers/scripts/tobeloved-api/deployments')
+    ]);
+    result.pages={status:pages.status,httpStatus:pages.httpStatus};
+    if(pages.data){
+      const p=pages.data,source=p.source?.config||{},deployment=p.canonical_deployment;
+      result.pages={...result.pages,
+        sourceRepositoryMatchesCandidate:source.owner==='ndiangrace-create'&&source.repo_name==='DOING',
+        productionBranchMatchesCandidate:p.production_branch==='main',
+        productionCommitMatchesBaseline:deployment?.deployment_trigger?.metadata?.commit_hash==='55f7584eb1de35c762cac28bb51289f7d999619e',
+        hasProductionDeployment:!!deployment};
+    }
+    result.worker={settingsStatus:settings.status,deploymentsStatus:deployments.status};
+    if(settings.data){
+      // Public CI output contains only booleans, never account or database identifiers.
+      result.worker.hasDatabaseBinding=(settings.data.bindings||[]).some(b=>b.name==='SUPABASE_URL');
+    }
+    if(deployments.data)result.worker.hasDeployment=(deployments.data.deployments||[]).length>0;
+    result.status=pages.status==='available'&&settings.status==='available'&&deployments.status==='available'?'read_complete':'partially_unavailable';
+  }catch{result.status='blocked_network_or_response';}
+}
+fs.writeFileSync(out,JSON.stringify(result,null,2)+'\n');
+console.log(JSON.stringify({status:result.status,mode:result.mode,productionWrites:0,artifact:out}));
