 function renderWorkspace(w){const id=workspaceId(w);const status=String(w.status||w.tenantStatus||w.tenant_status||'active');const role=String(w.role||w.staffRole||w.staff_role||'營運成員');return `<article class="system-card p-5" data-workspace="${esc(id)}"><span class="category-tag bg-[#e9e4ff] text-[#6658bc]">${esc(role)}</span><h3 class="mt-3 text-xl font-black">${esc(workspaceName(w))}</h3><p class="mt-1 text-sm font-bold text-slate-500">狀態：${esc(status)}</p><button class="card-action mt-5" type="button" data-open-workspace="${esc(id)}">進入工作空間</button></article>`}
 async function openWorkspace(id,btn,targetSystem=''){if(!id||!token)return;if(btn){btn.disabled=true;btn.textContent='正在進入…'}try{const d=await apiPost('createMemberWorkspaceAdminSession',{member_token:token,tenantId:id});const data=d.data??d.result??d;const adminToken=data.adminToken||data.admin_token||'';const tenant=data.tenantId||data.tenant_id||id;if(!adminToken)throw Error('無法建立工作空間登入');const u=new URL(systemRoute(targetSystem),location.origin);u.searchParams.set('tenant',tenant);u.searchParams.set('admin_token',adminToken);location.href=u.toString()}catch(e){if(btn){btn.disabled=false;btn.textContent='進入工作空間'}else{$('identityLine').textContent='已登入，但暫時無法開啟系統首頁。你可以從下方工作空間再試一次。'}if(btn)alert(e.message||'無法進入工作空間')}}
 async function load(){const d=await apiGet('getPlatformMemberProfile',{member_token:token});const profile=d.profile||d.member||{};const workspaces=Array.isArray(d.workspaces)?d.workspaces:[];const applications=Array.isArray(d.applications)?d.applications:[];$('loginView').classList.add('hidden');$('appView').classList.remove('hidden');$('logout').classList.remove('hidden');$('hello').textContent=(profile.name||profile.displayName||'你好')+'，歡迎回來';$('identityLine').textContent=workspaces.length?`你目前有 ${workspaces.length} 個可進入的工作空間`:'目前沒有可進入的工作空間';$('workspaceList').innerHTML=workspaces.map(renderWorkspace).join('');$('workspaceList').classList.toggle('hidden',workspaces.length===0);$('emptyWorkspace').classList.toggle('hidden',workspaces.length!==0);document.querySelectorAll('[data-open-workspace]').forEach(btn=>btn.onclick=()=>openWorkspace(btn.dataset.openWorkspace,btn));$('loginMessage').textContent='';if(freshLogin&&workspaces.length===1){freshLogin=false;const id=workspaceId(workspaces[0]),target=inferSystem(applications,id);if(target){$('identityLine').textContent='登入成功，正在開啟你的系統…';await openWorkspace(id,null,target)}}}
