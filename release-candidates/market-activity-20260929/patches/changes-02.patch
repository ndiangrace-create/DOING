 async function loadConsignment(){const tenant=currentTenant(),panel=document.getElementById('marketPortalPanel');if(!tenant||!panel)return;panel.classList.remove('hidden');panel.innerHTML='<div class="empty">正在讀取寄賣檔期…</div>';try{const u=new URL(API);u.searchParams.set('action','getConsignmentPeriodsPublic');u.searchParams.set('tenant',tenant);const r=await fetch(u,{cache:'no-store'}),d=await r.json().catch(()=>({}));if(!r.ok||d?.error)throw new Error(d?.error||'寄賣檔期讀取失敗');consignmentRows=Array.isArray(d)?d:[];panel.innerHTML=consignmentRows.length?`<div class="market-consignment-list">${consignmentRows.map(p=>`<article class="market-consignment-card"><div><b>${escapeHtml(p.name||'寄賣檔期')}</b><small>${escapeHtml(String(p.starts_at||'').slice(0,10))} ～ ${escapeHtml(String(p.ends_at||'').slice(0,10))}</small><small>抽成 ${Number(p.commission_percent||0)}%</small></div><button type="button" class="btn" data-consignment-apply="${escapeHtml(p.id)}">申請寄賣</button></article>`).join('')}</div>`:'<div class="empty">目前沒有開放中的寄賣檔期。</div>';panel.querySelectorAll('[data-consignment-apply]').forEach(b=>b.onclick=()=>openConsignmentDialog(consignmentRows.find(p=>String(p.id)===String(b.dataset.consignmentApply))))}catch(e){panel.innerHTML=`<div class="empty">${escapeHtml(e.message)}</div>`}}
 function ensureConsignmentDialog(){if(document.getElementById('marketConsignmentDialog'))return;const box=document.createElement('div');box.id='marketConsignmentDialog';box.className='modal-bg';box.innerHTML=`<div class="modal" style="max-width:620px"><div class="modal-head"><div><h2>申請寄賣</h2><p id="marketConsignmentSub"></p></div><button class="close" data-market-consignment-close>×</button></div><div class="modal-body"><div class="form-grid"><div class="field full"><label>品牌／單位名稱</label><input id="marketConsignmentBrand" autocomplete="organization"></div><div class="field full"><label>備註</label><textarea id="marketConsignmentNote" placeholder="可填商品類型、寄賣需求或其他說明"></textarea></div></div><div id="marketConsignmentLoginHint" class="ann hidden" style="margin-top:12px"></div></div><div class="modal-foot"><button type="button" class="btn outline" data-market-consignment-close>取消</button><button type="button" class="btn" id="marketConsignmentSubmit">送出寄賣申請</button></div></div>`;document.body.appendChild(box);box.querySelectorAll('[data-market-consignment-close]').forEach(b=>b.onclick=()=>box.classList.remove('show'))}
